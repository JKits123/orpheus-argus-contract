{
  "name": "@orpheus/argus-contract",
  "version": "1.0.0",
  "description": "Shared ARGUS platform contract for ORPHEUS companions — JSON Schema + Zod validator for the 15-field reporting envelope (ORPHEUS_PLATFORM_SPEC_v2.0 Section 3).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/tools/generate-json-schema.js",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod-to-json-schema": "^3.23.5"
  },
  "engines": {
    "node": ">=18"
  }
}
